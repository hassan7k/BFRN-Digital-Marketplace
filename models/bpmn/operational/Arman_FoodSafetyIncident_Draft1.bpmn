<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_FoodSafety" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_FoodSafety">
    <bpmn:participant id="Participant_Customer" name="Customer" processRef="Process_Customer" />
    <bpmn:participant id="Participant_Marketplace" name="BRFN Marketplace (Incident Triage &amp; Traceability)" processRef="Process_Marketplace" />
    <bpmn:participant id="Participant_Producer" name="Producer" processRef="Process_Producer" />
    <bpmn:participant id="Participant_Admin" name="Marketplace Administrator" processRef="Process_Admin" />
    <bpmn:messageFlow id="MsgFlow_Complaint" name="Submit complaint" sourceRef="Task_SubmitComplaint" targetRef="StartEvent_ComplaintReceived" />
    <bpmn:messageFlow id="MsgFlow_AlertProducer" name="Request batch logs" sourceRef="Task_RequestBatchLogs" targetRef="StartEvent_AlertReceived" />
    <bpmn:messageFlow id="MsgFlow_SubmitLogs" name="Batch logs (24h)" sourceRef="Task_SubmitBatchLogs" targetRef="Task_ReceiveProducerLogs" />
    <bpmn:messageFlow id="MsgFlow_EscalateAdmin" name="Investigation package" sourceRef="Task_SendToAdmin" targetRef="StartEvent_PackageReceived" />
    <bpmn:messageFlow id="MsgFlow_NotifyCustomer" name="Resolution notice" sourceRef="Task_CloseAndNotify" targetRef="CatchEvent_ResolutionReceived" />
  </bpmn:collaboration>

  <!-- POOL 1: CUSTOMER -->
  <bpmn:process id="Process_Customer" isExecutable="true">
    <bpmn:startEvent id="StartEvent_IssueDiscovered" name="Food safety issue discovered">
      <bpmn:outgoing>Flow_C1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="Task_SubmitComplaint" name="Submit food safety complaint">
      <bpmn:incoming>Flow_C1</bpmn:incoming>
      <bpmn:outgoing>Flow_C2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:intermediateCatchEvent id="CatchEvent_ResolutionReceived" name="Receive resolution notice">
      <bpmn:incoming>Flow_C2</bpmn:incoming>
      <bpmn:outgoing>Flow_C3</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MsgDef_C1" />
    </bpmn:intermediateCatchEvent>
    <bpmn:endEvent id="EndEvent_CustomerNotified" name="Customer notified">
      <bpmn:incoming>Flow_C3</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_C1" sourceRef="StartEvent_IssueDiscovered" targetRef="Task_SubmitComplaint" />
    <bpmn:sequenceFlow id="Flow_C2" sourceRef="Task_SubmitComplaint" targetRef="CatchEvent_ResolutionReceived" />
    <bpmn:sequenceFlow id="Flow_C3" sourceRef="CatchEvent_ResolutionReceived" targetRef="EndEvent_CustomerNotified" />
  </bpmn:process>

  <!-- POOL 2: BRFN MARKETPLACE -->
  <bpmn:process id="Process_Marketplace" isExecutable="true">
    <bpmn:startEvent id="StartEvent_ComplaintReceived" name="Complaint received">
      <bpmn:outgoing>Flow_M1</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MsgDef_M1" />
    </bpmn:startEvent>
    <bpmn:task id="Task_IsolateBatch" name="Isolate affected batch &amp; halt stock">
      <bpmn:incoming>Flow_M1</bpmn:incoming>
      <bpmn:outgoing>Flow_M2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:parallelGateway id="Gateway_ParallelSplit">
      <bpmn:incoming>Flow_M2</bpmn:incoming>
      <bpmn:outgoing>Flow_M3a</bpmn:outgoing>
      <bpmn:outgoing>Flow_M3b</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:task id="Task_QueryLogs" name="Query supply chain traceability logs">
      <bpmn:incoming>Flow_M3a</bpmn:incoming>
      <bpmn:outgoing>Flow_M4a</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_RequestBatchLogs" name="Request batch logs from producer">
      <bpmn:incoming>Flow_M3b</bpmn:incoming>
      <bpmn:outgoing>Flow_M3c</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_ReceiveProducerLogs" name="Receive producer batch logs">
      <bpmn:incoming>Flow_M3c</bpmn:incoming>
      <bpmn:outgoing>Flow_M4b</bpmn:outgoing>
    </bpmn:task>
    <bpmn:parallelGateway id="Gateway_ParallelJoin">
      <bpmn:incoming>Flow_M4a</bpmn:incoming>
      <bpmn:incoming>Flow_M4b</bpmn:incoming>
      <bpmn:outgoing>Flow_M5</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:task id="Task_SendToAdmin" name="Send investigation package to Admin">
      <bpmn:incoming>Flow_M5</bpmn:incoming>
      <bpmn:outgoing>Flow_M6</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="EndEvent_TriageComplete" name="Escalated to Admin">
      <bpmn:incoming>Flow_M6</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_M1" sourceRef="StartEvent_ComplaintReceived" targetRef="Task_IsolateBatch" />
    <bpmn:sequenceFlow id="Flow_M2" sourceRef="Task_IsolateBatch" targetRef="Gateway_ParallelSplit" />
    <bpmn:sequenceFlow id="Flow_M3a" sourceRef="Gateway_ParallelSplit" targetRef="Task_QueryLogs" />
    <bpmn:sequenceFlow id="Flow_M3b" sourceRef="Gateway_ParallelSplit" targetRef="Task_RequestBatchLogs" />
    <bpmn:sequenceFlow id="Flow_M3c" sourceRef="Task_RequestBatchLogs" targetRef="Task_ReceiveProducerLogs" />
    <bpmn:sequenceFlow id="Flow_M4a" sourceRef="Task_QueryLogs" targetRef="Gateway_ParallelJoin" />
    <bpmn:sequenceFlow id="Flow_M4b" sourceRef="Task_ReceiveProducerLogs" targetRef="Gateway_ParallelJoin" />
    <bpmn:sequenceFlow id="Flow_M5" sourceRef="Gateway_ParallelJoin" targetRef="Task_SendToAdmin" />
    <bpmn:sequenceFlow id="Flow_M6" sourceRef="Task_SendToAdmin" targetRef="EndEvent_TriageComplete" />
  </bpmn:process>

  <!-- POOL 3: PRODUCER -->
  <bpmn:process id="Process_Producer" isExecutable="true">
    <bpmn:startEvent id="StartEvent_AlertReceived" name="Incident alert received">
      <bpmn:outgoing>Flow_P1</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MsgDef_P1" />
    </bpmn:startEvent>
    <bpmn:task id="Task_CompileRecords" name="Compile batch &amp; hygiene records">
      <bpmn:incoming>Flow_P1</bpmn:incoming>
      <bpmn:outgoing>Flow_P2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_SubmitBatchLogs" name="Submit batch logs within 24h">
      <bpmn:incoming>Flow_P2</bpmn:incoming>
      <bpmn:outgoing>Flow_P3</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="EndEvent_LogsSubmitted" name="Logs submitted">
      <bpmn:incoming>Flow_P3</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_P1" sourceRef="StartEvent_AlertReceived" targetRef="Task_CompileRecords" />
    <bpmn:sequenceFlow id="Flow_P2" sourceRef="Task_CompileRecords" targetRef="Task_SubmitBatchLogs" />
    <bpmn:sequenceFlow id="Flow_P3" sourceRef="Task_SubmitBatchLogs" targetRef="EndEvent_LogsSubmitted" />
  </bpmn:process>

  <!-- POOL 4: MARKETPLACE ADMINISTRATOR -->
  <bpmn:process id="Process_Admin" isExecutable="true">
    <bpmn:startEvent id="StartEvent_PackageReceived" name="Investigation package received">
      <bpmn:outgoing>Flow_A1</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MsgDef_A1" />
    </bpmn:startEvent>
    <bpmn:task id="Task_ReviewLogs" name="Review logs &amp; assess compliance">
      <bpmn:incoming>Flow_A1</bpmn:incoming>
      <bpmn:outgoing>Flow_A2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Gateway_IncidentConfirmed" name="Incident confirmed?">
      <bpmn:incoming>Flow_A2</bpmn:incoming>
      <bpmn:outgoing>Flow_No</bpmn:outgoing>
      <bpmn:outgoing>Flow_Yes</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Task_ClearBatch" name="Clear batch &amp; restore stock">
      <bpmn:incoming>Flow_No</bpmn:incoming>
      <bpmn:outgoing>Flow_A3a</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_RecallAndRefund" name="Trigger batch recall &amp; issue customer refund">
      <bpmn:incoming>Flow_Yes</bpmn:incoming>
      <bpmn:outgoing>Flow_A3b</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_ApplyPenalty" name="Apply producer compliance penalty">
      <bpmn:incoming>Flow_A3b</bpmn:incoming>
      <bpmn:outgoing>Flow_A3c</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Gateway_MergeDecision">
      <bpmn:incoming>Flow_A3a</bpmn:incoming>
      <bpmn:incoming>Flow_A3c</bpmn:incoming>
      <bpmn:outgoing>Flow_A4</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Task_CloseAndNotify" name="Close incident &amp; notify customer">
      <bpmn:incoming>Flow_A4</bpmn:incoming>
      <bpmn:outgoing>Flow_A5</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="EndEvent_IncidentResolved" name="Incident resolved">
      <bpmn:incoming>Flow_A5</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_A1" sourceRef="StartEvent_PackageReceived" targetRef="Task_ReviewLogs" />
    <bpmn:sequenceFlow id="Flow_A2" sourceRef="Task_ReviewLogs" targetRef="Gateway_IncidentConfirmed" />
    <bpmn:sequenceFlow id="Flow_No" name="No" sourceRef="Gateway_IncidentConfirmed" targetRef="Task_ClearBatch" />
    <bpmn:sequenceFlow id="Flow_Yes" name="Yes" sourceRef="Gateway_IncidentConfirmed" targetRef="Task_RecallAndRefund" />
    <bpmn:sequenceFlow id="Flow_A3a" sourceRef="Task_ClearBatch" targetRef="Gateway_MergeDecision" />
    <bpmn:sequenceFlow id="Flow_A3b" sourceRef="Task_RecallAndRefund" targetRef="Task_ApplyPenalty" />
    <bpmn:sequenceFlow id="Flow_A3c" sourceRef="Task_ApplyPenalty" targetRef="Gateway_MergeDecision" />
    <bpmn:sequenceFlow id="Flow_A4" sourceRef="Gateway_MergeDecision" targetRef="Task_CloseAndNotify" />
    <bpmn:sequenceFlow id="Flow_A5" sourceRef="Task_CloseAndNotify" targetRef="EndEvent_IncidentResolved" />
  </bpmn:process>

  <!-- DIAGRAM VISUAL LAYOUT -->
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="Collaboration_FoodSafety">
      <!-- Pool 1: Customer -->
      <bpmndi:BPMNShape id="Shape_Participant_Customer" bpmnElement="Participant_Customer" isHorizontal="true">
        <dc:Bounds x="160" y="60" width="1100" height="140" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_StartEvent_IssueDiscovered" bpmnElement="StartEvent_IssueDiscovered">
        <dc:Bounds x="222" y="112" width="36" height="36" />
        <bpmndi:BPMNLabel><dc:Bounds x="198" y="155" width="84" height="27" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Task_SubmitComplaint" bpmnElement="Task_SubmitComplaint">
        <dc:Bounds x="310" y="90" width="110" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_CatchEvent_ResolutionReceived" bpmnElement="CatchEvent_ResolutionReceived">
        <dc:Bounds x="1042" y="112" width="36" height="36" />
        <bpmndi:BPMNLabel><dc:Bounds x="1015" y="75" width="90" height="27" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_EndEvent_CustomerNotified" bpmnElement="EndEvent_CustomerNotified">
        <dc:Bounds x="1152" y="112" width="36" height="36" />
        <bpmndi:BPMNLabel><dc:Bounds x="1128" y="155" width="85" height="14" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Edge_Flow_C1" bpmnElement="Flow_C1">
        <di:waypoint x="258" y="130" /><di:waypoint x="310" y="130" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_C2" bpmnElement="Flow_C2">
        <di:waypoint x="420" y="130" /><di:waypoint x="1042" y="130" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_C3" bpmnElement="Flow_C3">
        <di:waypoint x="1078" y="130" /><di:waypoint x="1152" y="130" />
      </bpmndi:BPMNEdge>

      <!-- Pool 2: BRFN Marketplace -->
      <bpmndi:BPMNShape id="Shape_Participant_Marketplace" bpmnElement="Participant_Marketplace" isHorizontal="true">
        <dc:Bounds x="160" y="230" width="1100" height="230" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_StartEvent_ComplaintReceived" bpmnElement="StartEvent_ComplaintReceived">
        <dc:Bounds x="222" y="322" width="36" height="36" />
        <bpmndi:BPMNLabel><dc:Bounds x="195" y="365" width="90" height="14" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Task_IsolateBatch" bpmnElement="Task_IsolateBatch">
        <dc:Bounds x="310" y="300" width="110" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Gateway_ParallelSplit" bpmnElement="Gateway_ParallelSplit">
        <dc:Bounds x="465" y="315" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Task_QueryLogs" bpmnElement="Task_QueryLogs">
        <dc:Bounds x="560" y="245" width="120" height="75" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Task_RequestBatchLogs" bpmnElement="Task_RequestBatchLogs">
        <dc:Bounds x="560" y="360" width="120" height="75" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Task_ReceiveProducerLogs" bpmnElement="Task_ReceiveProducerLogs">
        <dc:Bounds x="720" y="360" width="120" height="75" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Gateway_ParallelJoin" bpmnElement="Gateway_ParallelJoin">
        <dc:Bounds x="885" y="315" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Task_SendToAdmin" bpmnElement="Task_SendToAdmin">
        <dc:Bounds x="980" y="300" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_EndEvent_TriageComplete" bpmnElement="EndEvent_TriageComplete">
        <dc:Bounds x="1152" y="322" width="36" height="36" />
        <bpmndi:BPMNLabel><dc:Bounds x="1125" y="365" width="90" height="14" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Edge_Flow_M1" bpmnElement="Flow_M1">
        <di:waypoint x="258" y="340" /><di:waypoint x="310" y="340" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_M2" bpmnElement="Flow_M2">
        <di:waypoint x="420" y="340" /><di:waypoint x="465" y="340" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_M3a" bpmnElement="Flow_M3a">
        <di:waypoint x="490" y="315" /><di:waypoint x="490" y="282" /><di:waypoint x="560" y="282" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_M3b" bpmnElement="Flow_M3b">
        <di:waypoint x="490" y="365" /><di:waypoint x="490" y="397" /><di:waypoint x="560" y="397" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_M3c" bpmnElement="Flow_M3c">
        <di:waypoint x="680" y="397" /><di:waypoint x="720" y="397" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_M4a" bpmnElement="Flow_M4a">
        <di:waypoint x="680" y="282" /><di:waypoint x="910" y="282" /><di:waypoint x="910" y="315" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_M4b" bpmnElement="Flow_M4b">
        <di:waypoint x="840" y="397" /><di:waypoint x="910" y="397" /><di:waypoint x="910" y="365" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_M5" bpmnElement="Flow_M5">
        <di:waypoint x="935" y="340" /><di:waypoint x="980" y="340" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_M6" bpmnElement="Flow_M6">
        <di:waypoint x="1100" y="340" /><di:waypoint x="1152" y="340" />
      </bpmndi:BPMNEdge>

      <!-- Pool 3: Producer -->
      <bpmndi:BPMNShape id="Shape_Participant_Producer" bpmnElement="Participant_Producer" isHorizontal="true">
        <dc:Bounds x="160" y="490" width="1100" height="140" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_StartEvent_AlertReceived" bpmnElement="StartEvent_AlertReceived">
        <dc:Bounds x="392" y="542" width="36" height="36" />
        <bpmndi:BPMNLabel><dc:Bounds x="368" y="585" width="84" height="27" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Task_CompileRecords" bpmnElement="Task_CompileRecords">
        <dc:Bounds x="480" y="520" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Task_SubmitBatchLogs" bpmnElement="Task_SubmitBatchLogs">
        <dc:Bounds x="650" y="520" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_EndEvent_LogsSubmitted" bpmnElement="EndEvent_LogsSubmitted">
        <dc:Bounds x="832" y="542" width="36" height="36" />
        <bpmndi:BPMNLabel><dc:Bounds x="812" y="585" width="76" height="14" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Edge_Flow_P1" bpmnElement="Flow_P1">
        <di:waypoint x="428" y="560" /><di:waypoint x="480" y="560" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_P2" bpmnElement="Flow_P2">
        <di:waypoint x="600" y="560" /><di:waypoint x="650" y="560" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_P3" bpmnElement="Flow_P3">
        <di:waypoint x="770" y="560" /><di:waypoint x="832" y="560" />
      </bpmndi:BPMNEdge>

      <!-- Pool 4: Marketplace Administrator -->
      <bpmndi:BPMNShape id="Shape_Participant_Admin" bpmnElement="Participant_Admin" isHorizontal="true">
        <dc:Bounds x="160" y="660" width="1100" height="230" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_StartEvent_PackageReceived" bpmnElement="StartEvent_PackageReceived">
        <dc:Bounds x="222" y="752" width="36" height="36" />
        <bpmndi:BPMNLabel><dc:Bounds x="195" y="795" width="90" height="27" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Task_ReviewLogs" bpmnElement="Task_ReviewLogs">
        <dc:Bounds x="310" y="730" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Gateway_IncidentConfirmed" bpmnElement="Gateway_IncidentConfirmed" isMarkerVisible="true">
        <dc:Bounds x="475" y="745" width="50" height="50" />
        <bpmndi:BPMNLabel><dc:Bounds x="530" y="763" width="88" height="14" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Task_ClearBatch" bpmnElement="Task_ClearBatch">
        <dc:Bounds x="590" y="675" width="120" height="75" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Task_RecallAndRefund" bpmnElement="Task_RecallAndRefund">
        <dc:Bounds x="590" y="795" width="120" height="75" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Task_ApplyPenalty" bpmnElement="Task_ApplyPenalty">
        <dc:Bounds x="750" y="795" width="120" height="75" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Gateway_MergeDecision" bpmnElement="Gateway_MergeDecision" isMarkerVisible="true">
        <dc:Bounds x="905" y="745" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Task_CloseAndNotify" bpmnElement="Task_CloseAndNotify">
        <dc:Bounds x="1000" y="730" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_EndEvent_IncidentResolved" bpmnElement="EndEvent_IncidentResolved">
        <dc:Bounds x="1162" y="752" width="36" height="36" />
        <bpmndi:BPMNLabel><dc:Bounds x="1138" y="795" width="84" height="14" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Edge_Flow_A1" bpmnElement="Flow_A1">
        <di:waypoint x="258" y="770" /><di:waypoint x="310" y="770" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_A2" bpmnElement="Flow_A2">
        <di:waypoint x="430" y="770" /><di:waypoint x="475" y="770" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_No" bpmnElement="Flow_No">
        <di:waypoint x="500" y="745" /><di:waypoint x="500" y="712" /><di:waypoint x="590" y="712" />
        <bpmndi:BPMNLabel><dc:Bounds x="520" y="695" width="15" height="14" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_Yes" bpmnElement="Flow_Yes">
        <di:waypoint x="500" y="795" /><di:waypoint x="500" y="832" /><di:waypoint x="590" y="832" />
        <bpmndi:BPMNLabel><dc:Bounds x="520" y="815" width="18" height="14" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_A3a" bpmnElement="Flow_A3a">
        <di:waypoint x="710" y="712" /><di:waypoint x="930" y="712" /><di:waypoint x="930" y="745" />
      </bpmndi:BPMNEdge>
