        <di:waypoint x="380" y="500" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow_11_di" bpmnElement="SequenceFlow_11">
        <di:waypoint x="540" y="500" />
        <di:waypoint x="580" y="500" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNShape id="Participant_Cert_di" bpmnElement="Participant_Cert" isHorizontal="true">
        <dc:Bounds x="300" y="620" width="280" height="60" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Participant_Payment_di" bpmnElement="Participant_Payment" isHorizontal="true">
        <dc:Bounds x="960" y="620" width="240" height="60" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Participant_Notif_di" bpmnElement="Participant_Notif" isHorizontal="true">
        <dc:Bounds x="1220" y="620" width="260" height="60" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="MessageFlow_1_di" bpmnElement="MessageFlow_1">
        <di:waypoint x="340" y="180" />
        <di:waypoint x="340" y="620" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="MessageFlow_2_di" bpmnElement="MessageFlow_2">
        <di:waypoint x="400" y="620" />
        <di:waypoint x="400" y="180" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="MessageFlow_3_di" bpmnElement="MessageFlow_3">
