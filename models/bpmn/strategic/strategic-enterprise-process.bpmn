      <bpmndi:BPMNEdge id="MessageFlow_4_di" bpmnElement="MessageFlow_4">
        <di:waypoint x="1120" y="620" />
        <di:waypoint x="1120" y="420" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="MessageFlow_5_di" bpmnElement="MessageFlow_5">
        <di:waypoint x="1240" y="420" />
        <di:waypoint x="1240" y="620" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="MessageFlow_6_di" bpmnElement="MessageFlow_6">
        <di:waypoint x="1300" y="620" />
        <di:waypoint x="1300" y="420" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
